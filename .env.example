# Local Discord (no AWS / Cockroach). Memory is SQLite on this machine.
LOCAL_MODE=false
SQLITE_PATH=data/studyai.db

# CockroachDB (Serverless or Dedicated) — unused when LOCAL_MODE=true
DATABASE_URL=postgresql://user:password@host:26257/studyai?sslmode=verify-full

# Amazon Bedrock (optional for local-first — use EMBEDDING_MODE=local)
AWS_REGION=us-east-1
BEDROCK_EMBEDDING_MODEL=amazon.titan-embed-text-v1
BEDROCK_CHAT_MODEL=mistral.ministral-3-8b-instruct
# auto | bedrock | local — local uses deterministic 1536-d vectors (demo fallback)
EMBEDDING_MODE=auto
# auto | openai | bedrock | off — openai uses OPENAI_API_KEY then Bedrock
CHAT_PROVIDER=auto
CHAT_MODE=auto
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
# live /ask answers per Discord user per UTC day (0 = unlimited)
TUTOR_DAILY_CAP=20

# Discord
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=
DISCORD_GUILD_ID=
QUESTIONS_CHANNEL_IDS=
REPORT_CHANNEL_ID=

# Local FastAPI runtime (no AWS Lambda)
LOCAL_HOST=127.0.0.1
LOCAL_PORT=8080
# Point gateway at local server (or SAM URLs after AWS deploy):
# INGESTION_URL=http://127.0.0.1:8080/ingestion
# RESOLUTION_URL=http://127.0.0.1:8080/interactions

# Gap report tuning
SIMILARITY_THRESHOLD=0.3
# Prior-question match cutoff on /ask (tighter than syllabus linking)
SIMILAR_QUESTION_THRESHOLD=0.22
WEEKLY_REPORT_CRON='cron(0 17 ? * FRI *)'
